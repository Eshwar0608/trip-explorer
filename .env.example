# Supabase: Transaction pooler URI for the app (?pgbouncer=true, port 6543)
DATABASE_URL=

# Supabase: Direct connection URI for Prisma migrations (port 5432, no pgbouncer)
DIRECT_DATABASE_URL=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local: http://localhost:3000 | Production: https://your-app.vercel.app
NEXTAUTH_URL=

# Supabase Storage (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
