# Supabase PostgreSQL (Transaction pooler for Vercel: ?pgbouncer=true, port 6543)
DATABASE_URL=

# Optional: direct URI (port 5432) — used by build script to add missing columns
DIRECT_DATABASE_URL=

# Supabase Storage bucket name (default: trip-images — must exist and be public)
SUPABASE_STORAGE_BUCKET=trip-images

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local: http://localhost:3000 | Production: https://your-app.vercel.app
NEXTAUTH_URL=

# Supabase Storage (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
