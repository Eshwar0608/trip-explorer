{
  "name": "weekend-plans",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && node scripts/copy-prisma-wasm.mjs && next dev",
    "build": "prisma generate && prisma migrate deploy && node scripts/copy-prisma-wasm.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate && node scripts/copy-prisma-wasm.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
